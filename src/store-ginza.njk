<script>
/* === ヒーロー（3分割）スライドショー ===
   ・左右=動画 / 中央=写真を5秒ごとに自動で切り替え
   ・読み込めなかった画像は飛ばす */
(function(){
  var INTERVAL = 5000;
  [].slice.call(document.querySelectorAll('[data-slideshow]')).forEach(function(col){
    var slides = [].slice.call(col.querySelectorAll('.slide'));
    if (slides.length < 2) return;
    var i = 0, timer = null;
    function ready(img){ return img.complete && img.naturalWidth > 0 && !img.classList.contains('is-broken'); }
    function show(n){ if (n === i) return; slides[i].classList.remove('is-on'); i = n; slides[i].classList.add('is-on'); }
    function go(n){ for (var k = 0; k < slides.length; k++){ var x = (n + k) % slides.length; if (ready(slides[x])) { show(x); return; } } }
    slides.forEach(function(img, n){ img.addEventListener('error', function(){ img.classList.add('is-broken'); if (n === i) go(i + 1); }); });
    function start(){ clearInterval(timer); timer = setInterval(function(){ go(i + 1); }, INTERVAL); }
    function stop(){ clearInterval(timer); timer = null; }
    setTimeout(start, parseInt(col.getAttribute('data-offset') || '0', 10));
    document.addEventListener('visibilitychange', function(){ document.hidden ? stop() : start(); });
  });

  var dock = document.getElementById('dock'), hero = document.getElementById('hero');
  if (dock && hero && 'IntersectionObserver' in window){
    new IntersectionObserver(function(es){ dock.classList.toggle('is-on', !es[0].isIntersecting); }, {threshold:0.05}).observe(hero);
  }
})();
</script>
<script>
/* === 多言語（Google翻訳）===
   ・英語以外を選ぶと googtrans クッキーを保存して再読み込み → Google翻訳で自動翻訳
   ・英語に戻すとクッキーを消して元の英語ページに
   ・店名・住所・営業時間などは翻訳しない（notranslate） */
(function(){
  var box = document.getElementById('lang'); if (!box) return;
  var btn = box.querySelector('.lang-btn'), cur = document.getElementById('lang-cur');
  var host = location.hostname, root = host.split('.').slice(-2).join('.');
  function getLang(){ var m = document.cookie.match(/(?:^|;\s*)googtrans=\/[^/]*\/([^;]+)/); return m ? decodeURIComponent(m[1]) : 'en'; }
  function setCookie(v){
    var exp = v ? '' : '; expires=Thu, 01 Jan 1970 00:00:00 GMT';
    var val = v ? '/en/' + v : '';
    document.cookie = 'googtrans=' + val + '; path=/' + exp;
    document.cookie = 'googtrans=' + val + '; path=/; domain=.' + root + exp;
    document.cookie = 'googtrans=' + val + '; path=/; domain=' + host + exp;
  }
  var lang = getLang();
  box.querySelectorAll('[data-lang]').forEach(function(b){
    if (b.getAttribute('data-lang') === lang){ b.setAttribute('aria-current','true'); cur.textContent = b.lastElementChild.textContent; }
    b.addEventListener('click', function(){
      var v = b.getAttribute('data-lang');
      if (v === lang){ close(); return; }
      setCookie(v === 'en' ? '' : v);
      location.reload();
    });
  });
  function close(){ box.classList.remove('is-open'); btn.setAttribute('aria-expanded','false'); }
  btn.addEventListener('click', function(e){ e.stopPropagation(); var o = box.classList.toggle('is-open'); btn.setAttribute('aria-expanded', o ? 'true' : 'false'); });
  document.addEventListener('click', function(e){ if (!box.contains(e.target)) close(); });
  document.addEventListener('keydown', function(e){ if (e.key === 'Escape') close(); });

  if (lang !== 'en'){
    window.gtInit = function(){ new google.translate.TranslateElement({ pageLanguage: 'en', autoDisplay: false }, 'gt_el'); };
    var s = document.createElement('script');
    s.src = 'https://translate.google.com/translate_a/element.js?cb=gtInit';
    s.async = true; document.head.appendChild(s);
  }
})();
</script>
<script>
  /* === クリック計測（data-ga-event → dataLayer → GTM → GA4）=== store.njk と同じ仕組み */
  window.dataLayer = window.dataLayer || [];
  document.addEventListener('click', function (e) {
    var el = e.target.closest('[data-ga-event]');
    if (!el) return;
    window.dataLayer.push({
      event: el.getAttribute('data-ga-event'),
      event_label: (el.getAttribute('data-ga-location') || ''),
      store_name: '{{ store.slug }}',
      store_area: '{{ store.region }}',
      brand: 'steak',
      channel: 'default'
    });
  }, true);
</script>
