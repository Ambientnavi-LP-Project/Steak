---
# 銀座築地 専用デザイン
# stores.js で layout_variant: "ginza" の店舗だけをこのテンプレートで生成する
# （共通デザインは store.njk。URLは同じ /{region}/{slug}/）
pagination:
  data: stores.stores_ginza
  size: 1
  alias: store
permalink: "/{{ store.region }}/{{ store.slug }}/index.html"
eleventyComputed:
  title: "{{ store.name_full_en }}"
---
<!DOCTYPE html>
<html lang="en">
<head>
<!-- Google Tag Manager -->
<script>
  window.dataLayer = window.dataLayer || [];
  window.dataLayer.push({
    store_name: '{{ store.slug }}',
    store_area: '{{ store.region }}',
    brand: 'steak',
    channel: 'default'
  });
</script>
<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','GTM-5DGT9H6L');</script>
<!-- GA4 計測コンテキスト（計測用のみ・表示は変更なし） -->
<!-- End Google Tag Manager -->

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="description" content="{{ store.name_full_en }} — Japanese Wagyu. Muslim-Friendly. 5th-generation butcher since 1962." />
<title>{{ store.name_full_en }}</title>
<link rel="icon" href="/assets/favicon.ico" sizes="any" />
<link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png" />
<link rel="icon" type="image/png" sizes="192x192" href="/assets/favicon-192.png" />
<link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@500;700&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap" rel="stylesheet" />
<style>
  :root{
    --plaster:#DCD2C4; --washi:#F4EFE7; --sumi:#26221E; --sumi-2:#2F2A25;
    --shu:#B23A26; --brass:#A8895A; --brass-lt:#D6B884; --ink:#2E2822; --ink-soft:#6B6157; --paper:#F1EADF; --muted:#B7AC9E;
    --serif:'Shippori Mincho','Hiragino Mincho ProN','Yu Mincho',Georgia,serif;
    --sans:'Zen Kaku Gothic New','Hiragino Sans','Noto Sans JP',system-ui,sans-serif;
    --gutter:clamp(20px,5vw,40px);
    box-sizing:border-box;
    padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
  }
  *,*::before,*::after{box-sizing:inherit;margin:0;padding:0}
  html{scroll-padding-top:env(safe-area-inset-top,0px);scroll-behavior:smooth}
  body{background:var(--washi);color:var(--ink);font-family:var(--sans);-webkit-font-smoothing:antialiased;overflow-x:hidden;line-height:1.7}
  img{max-width:100%;display:block}
  .wrap{width:100%;max-width:1040px;margin:0 auto;padding-inline:var(--gutter)}
  section{padding-block:clamp(64px,10vw,104px)}
  h2{font-family:var(--serif);font-weight:700;font-size:clamp(1.55rem,4.2vw,2.3rem);line-height:1.3;text-wrap:balance}
  .lead{font-family:var(--serif);font-size:16px;line-height:2;max-width:38em}

  /* HERO — 3分割：左=バーガー動画 / 中央=写真スライドショー / 右=ステーキ丼動画（スマホは左のバーガー動画のみ） */
  .hero{position:relative;min-height:100svh;display:flex;flex-direction:column;color:#FBF7F1;overflow:hidden;background:#141210;padding:0}
  .triptych{position:absolute;inset:clamp(10px,1.6vw,20px);display:grid;grid-template-columns:1fr 1fr 1fr;gap:clamp(10px,1.6vw,20px);border-radius:4px;overflow:hidden}
  .tri-col{position:relative;overflow:hidden;border-radius:3px;background:var(--sumi)}
  .tri-col video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  @keyframes col-up{from{clip-path:inset(100% 0 0 0)}to{clip-path:inset(0 0 0 0)}}
  .tri-col:nth-child(1){animation:col-up .95s 0s cubic-bezier(.22,1,.36,1) both}
  .tri-col:nth-child(2){animation:col-up .95s .14s cubic-bezier(.22,1,.36,1) both}
  .tri-col:nth-child(3){animation:col-up .95s .28s cubic-bezier(.22,1,.36,1) both}
  .slide{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:var(--pos,center);opacity:0;transform:scale(1.06);transition:opacity 1.4s ease,transform 7s ease-out}
  .slide.is-on{opacity:1;transform:scale(1)}
  .slide.is-broken{display:none}
  .hero::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(20,18,16,.6) 0%,rgba(20,18,16,0) 22%,rgba(20,18,16,0) 42%,rgba(20,18,16,.72) 70%,rgba(20,18,16,.96) 100%);pointer-events:none}
  .hero-top{position:relative;z-index:2;padding-top:calc(clamp(10px,1.6vw,20px) + 18px);display:flex;align-items:flex-start;justify-content:space-between;gap:16px}
  .hero-top img{height:clamp(64px,10vw,96px);width:auto}
  .hero-in{position:relative;z-index:1;margin-top:auto;padding-bottom:clamp(36px,5vw,56px);display:grid;gap:22px}
  .hero h1{font-family:var(--serif);font-weight:500;font-size:clamp(.98rem,2.2vw,1.2rem);line-height:1.6;max-width:30em;color:#EFE6D8;overflow-wrap:anywhere}
  .walkin{display:inline-block;margin-top:10px;font-size:12px;color:var(--brass-lt);letter-spacing:.06em}
  @media (max-width:767px){
    .triptych{grid-template-columns:1fr}
    .tri-col:nth-child(2),.tri-col:nth-child(3){display:none}   /* スマホはバーガー動画（左列）だけ */
  }

  /* LANGUAGE */
  .lang{position:relative}
  .lang-btn{display:flex;align-items:center;gap:8px;min-height:44px;padding:0 14px;border:0;border-radius:3px;background:rgba(20,18,16,.55);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);color:#F7F0E4;box-shadow:inset 0 0 0 1px rgba(214,184,132,.55);font:500 13px/1 var(--sans);cursor:pointer}
  .lang-btn svg{width:17px;height:17px}
  .lang-btn:focus-visible,.lang-list button:focus-visible{outline:2px solid var(--brass-lt);outline-offset:2px}
  .lang-list{position:absolute;right:0;top:calc(100% + 8px);min-width:200px;padding:6px;border-radius:4px;background:rgba(20,18,16,.96);box-shadow:0 14px 34px -10px rgba(0,0,0,.6),inset 0 0 0 1px rgba(214,184,132,.35);display:none;z-index:70}
  .lang.is-open .lang-list{display:grid}
  .lang-list button{display:flex;justify-content:space-between;gap:12px;width:100%;min-height:42px;padding:0 12px;border:0;border-radius:3px;background:none;color:#EFE6D8;font:400 14px/1 var(--sans);text-align:left;cursor:pointer}
  .lang-list button:hover{background:rgba(214,184,132,.14)}
  .lang-list button[aria-current="true"]{color:var(--brass-lt)}
  .lang-list button span:last-child{color:var(--muted);font-size:11px}
  /* Google翻訳のバナー・ツールチップを隠す */
  iframe.skiptranslate,.goog-te-banner-frame,#goog-gt-tt,.goog-te-balloon-frame,#gt_el{display:none!important}
  body{top:0!important}
  font[style]{background:none!important;box-shadow:none!important}
  .VIpgJd-ZVi9od-ORHb-OEVmcd,.VIpgJd-ZVi9od-aZ2wEe-wOHMyf{display:none!important}
  .VIpgJd-yAWNEb-VIpgJd-fmcmS-sn54Q{background:none!important;box-shadow:none!important}

  /* ACTIONS */
  .cta{display:grid;grid-template-columns:repeat(2,minmax(0,290px));gap:12px}
  .act{display:flex;align-items:center;gap:14px;min-height:72px;padding:12px 20px 12px 14px;text-decoration:none;border-radius:3px;transition:transform .25s ease,box-shadow .25s ease,background .25s ease}
  .act-ic{flex:none;width:42px;height:42px;border-radius:50%;display:grid;place-items:center}
  .act-ic svg{width:21px;height:21px}
  .act-tx{display:grid;gap:2px;min-width:0}
  .act b{font-family:var(--serif);font-weight:700;font-size:17px;line-height:1.25}
  .act small{font-size:12px;opacity:.82}
  .act-go{background:linear-gradient(180deg,#C2442E,#9E2F1D);color:#fff;box-shadow:inset 0 0 0 1px rgba(232,203,150,.55),inset 0 0 0 4px #9E2F1D,inset 0 0 0 5px rgba(232,203,150,.35),0 10px 28px -10px rgba(178,58,38,.7)}
  .act-go .act-ic{background:rgba(255,255,255,.14);color:#F6E6C8}
  .act-rsv{background:rgba(30,27,24,.55);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);color:#F7F0E4;box-shadow:inset 0 0 0 1px rgba(214,184,132,.75)}
  .act-rsv .act-ic{background:rgba(214,184,132,.16);color:var(--brass-lt)}
  .act:hover{transform:translateY(-2px)}
  .act-rsv:hover{background:rgba(214,184,132,.16)}
  .act:focus-visible,.dock a:focus-visible,.btn:focus-visible{outline:2px solid var(--brass-lt);outline-offset:3px}

  /* WAGYU — lit niche with the brush logo */
  .about{background:var(--plaster)}
  .niche{background:var(--washi);border-radius:2px;text-align:center;padding:clamp(40px,7vw,64px) var(--gutter);
    box-shadow:inset 0 0 0 1px rgba(255,255,255,.6),inset 0 18px 40px -18px rgba(120,96,60,.35),inset 0 -18px 40px -22px rgba(120,96,60,.25),0 0 60px rgba(255,236,200,.55)}
  .niche img{height:clamp(120px,22vw,170px);width:auto;margin:0 auto 22px}
  .niche p{font-family:var(--serif);color:var(--ink-soft);font-size:15px;margin-top:8px}
  .about .lead{margin:clamp(36px,6vw,52px) auto 0}
  .about .lead+.lead{margin-top:1.2em}

  /* MENU — one framed photo per dish */
  .menu{background:var(--sumi);color:var(--paper)}
  .menu h2{margin-bottom:clamp(28px,5vw,44px)}
  .dishes{display:grid;grid-template-columns:1fr 1fr;gap:clamp(16px,3vw,28px)}
  .dish{padding:10px;box-shadow:inset 0 0 0 1px rgba(214,184,132,.35);border-radius:3px;background:var(--sumi-2)}
  .dish figure{overflow:hidden;border-radius:2px;aspect-ratio:1/1}
  .dish img{width:100%;height:100%;object-fit:cover;object-position:var(--pos,center)}
  .dish h3{font-family:var(--serif);font-weight:700;font-size:1.35rem;text-align:center;padding:16px 0 8px;color:#F7F0E4}
  .dish.feature{grid-column:1/-1}
  .dish.feature figure{aspect-ratio:16/9}
  .dish.feature h3{font-size:clamp(1.8rem,4.5vw,2.4rem);padding:20px 0 12px}

  /* INSIDE */
  .space h2{margin-bottom:clamp(28px,5vw,40px)}
  .gallery{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(12px,2vw,20px)}
  .gallery figure{padding:8px;background:#fff;box-shadow:0 0 0 1px rgba(46,40,34,.08);border-radius:3px}
  .gallery img{width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:2px}

  /* RATING */
  .rating{background:var(--plaster);padding-block:clamp(48px,8vw,72px)}
  .rating .wrap{display:flex;align-items:center;justify-content:center;gap:clamp(18px,4vw,32px);text-align:left}
  .score{font-family:var(--serif);font-weight:700;font-size:clamp(3.6rem,11vw,5.4rem);line-height:1;color:var(--sumi)}
  .stars{color:#DB7A2C;letter-spacing:.12em;font-size:18px}
  .rating p{font-size:14px;color:var(--ink-soft)}

  /* STORY */
  .story h2 small{display:block;font-family:var(--sans);font-size:13px;font-weight:500;color:var(--brass);margin-top:10px;letter-spacing:.06em}
  .story-head{display:flex;align-items:center;gap:clamp(16px,3vw,24px)}
  .story-head img{width:clamp(72px,12vw,96px);height:auto;flex:none}
  .story .lead{margin-top:28px}
  .story .lead+.lead{margin-top:1.2em}

  /* VISIT */
  .visit{background:var(--sumi);color:var(--paper)}
  .visit-in{display:grid;grid-template-columns:1.1fr .9fr;gap:clamp(32px,6vw,56px);align-items:start}
  .visit h2{margin-bottom:28px}
  dl{display:grid;grid-template-columns:5.5em 1fr;gap:16px 18px;font-size:15px;margin-bottom:32px}
  dt{color:var(--muted);font-size:13px;padding-top:2px}
  dd small{display:block;color:var(--muted);font-size:13px}
  .btns{display:grid;gap:12px;max-width:400px}
  .btn{display:flex;align-items:center;justify-content:center;gap:10px;min-height:56px;border-radius:3px;text-decoration:none;font-family:var(--serif);font-weight:700;font-size:16px}
  .btn svg{width:19px;height:19px}
  .btn-go{background:linear-gradient(180deg,#C2442E,#9E2F1D);color:#fff;box-shadow:inset 0 0 0 1px rgba(232,203,150,.5)}
  .btn-rsv{color:#F7F0E4;box-shadow:inset 0 0 0 1px rgba(214,184,132,.7)}
  .entry{padding:8px;box-shadow:inset 0 0 0 1px rgba(214,184,132,.35);border-radius:3px}
  .entry img{width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:2px}

  footer{background:#1E1B18;color:var(--muted);text-align:center;padding:48px var(--gutter) 120px;font-size:12px}
  footer img{width:84px;height:84px;margin:0 auto 14px}

  /* DOCK */
  .dock{position:fixed;left:50%;bottom:calc(12px + env(safe-area-inset-bottom,0px));z-index:60;display:flex;gap:6px;padding:6px;border-radius:4px;background:rgba(30,27,24,.92);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);box-shadow:0 12px 30px -8px rgba(0,0,0,.45),inset 0 0 0 1px rgba(214,184,132,.35);transform:translate(-50%,150%);opacity:0;transition:transform .45s cubic-bezier(.2,.8,.2,1),opacity .3s;width:min(calc(100% - 24px),440px)}
  .dock.is-on{transform:translate(-50%,0);opacity:1}
  .dock a{flex:1;display:flex;align-items:center;justify-content:center;gap:8px;min-height:50px;border-radius:3px;text-decoration:none;font-family:var(--serif);font-weight:700;font-size:15px}
  .dock svg{width:18px;height:18px}
  .dock-go{background:linear-gradient(180deg,#C2442E,#9E2F1D);color:#fff;box-shadow:inset 0 0 0 1px rgba(232,203,150,.45)}
  .dock-rsv{color:#F7F0E4;box-shadow:inset 0 0 0 1px rgba(214,184,132,.6)}

  @media (max-width:760px){
    .cta{grid-template-columns:1fr}
    .dishes{grid-template-columns:1fr}
    .dish.feature figure{aspect-ratio:4/3}
    .dish figure{aspect-ratio:4/3}
    .gallery{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;margin-inline:calc(var(--gutter) * -1);padding-inline:var(--gutter);scroll-padding-inline:var(--gutter);scrollbar-width:none}
    .gallery::-webkit-scrollbar{display:none}
    .gallery figure{flex:0 0 78%;scroll-snap-align:start}
    .visit-in{grid-template-columns:1fr}
    .entry{order:-1}
    .entry img{aspect-ratio:4/3}
    .btns{max-width:none}
  }
  @media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}.dock,.act{transition:none}.slide{transform:none;transition:opacity 1s ease}}
</style>
</head>
<body>
<!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-5DGT9H6L"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->

  <section class="hero" id="hero">
    <div class="triptych" aria-hidden="false">
      <div class="tri-col">
        <video autoplay muted loop playsinline preload="auto" poster="/assets/ginzatsukiji/hero-burger-poster.jpg">
          <source src="/assets/ginzatsukiji/hero-burger.mp4" type="video/mp4" />
        </video>
      </div>
      <div class="tri-col" data-slideshow>
        <img class="slide is-on" fetchpriority="high" src="/assets/ginzatsukiji/hero-interior.jpg" alt="Dining room" style="--pos:center 40%" />
        <img class="slide" src="/assets/ginzatsukiji/hero-burger.jpg" alt="Burger" style="--pos:50% 45%" />
        <img class="slide" src="/assets/ginzatsukiji/hero-steak.jpg" alt="Steak" style="--pos:55% 50%" />
        <img class="slide" src="/assets/ginzatsukiji/hero-burger-2.jpg" alt="Burger" style="--pos:50% 40%" />
      </div>
      <div class="tri-col">
        <video autoplay muted loop playsinline preload="metadata" onloadedmetadata="this.currentTime=3">
          <source src="/assets/hero-right-stedon.mp4" type="video/mp4" />
        </video>
      </div>
    </div>
    <div class="hero-top wrap">
      <img src="/assets/brand/logo-wagyu-white.png" alt="和牛 — {{ store.name_full_en }}" class="notranslate" translate="no" />
      <div class="lang notranslate" translate="no" id="lang">
        <button type="button" class="lang-btn" aria-haspopup="true" aria-expanded="false" aria-label="Language"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M3.5 12h17M12 3.5c2.6 2.6 3.6 5.6 3.6 8.5s-1 5.9-3.6 8.5c-2.6-2.6-3.6-5.6-3.6-8.5s1-5.9 3.6-8.5z" fill="none" stroke="currentColor" stroke-width="1.4"/></svg><span id="lang-cur">EN</span></button>
        <ul class="lang-list" role="menu" style="list-style:none;margin:0">
          <li><button type="button" data-lang="en" data-ga-event="language_select" data-ga-location="en"><span>English</span><span>EN</span></button></li>
          <li><button type="button" data-lang="ja" data-ga-event="language_select" data-ga-location="ja"><span>日本語</span><span>JA</span></button></li>
          <li><button type="button" data-lang="zh-CN" data-ga-event="language_select" data-ga-location="zh-CN"><span>简体中文</span><span>中文</span></button></li>
          <li><button type="button" data-lang="zh-TW" data-ga-event="language_select" data-ga-location="zh-TW"><span>繁體中文</span><span>繁中</span></button></li>
          <li><button type="button" data-lang="ko" data-ga-event="language_select" data-ga-location="ko"><span>한국어</span><span>KO</span></button></li>
          <li><button type="button" data-lang="ar" data-ga-event="language_select" data-ga-location="ar"><span>العربية</span><span>AR</span></button></li>
          <li><button type="button" data-lang="id" data-ga-event="language_select" data-ga-location="id"><span>Bahasa Indonesia</span><span>ID</span></button></li>
          <li><button type="button" data-lang="ms" data-ga-event="language_select" data-ga-location="ms"><span>Bahasa Melayu</span><span>MS</span></button></li>
        </ul>
      </div>
      <div id="gt_el"></div>
    </div>
    <div class="hero-in wrap">
      <div>
        <h1 class="notranslate" translate="no">{{ store.name_full_en }}</h1>
        <span class="walkin">Walk-ins welcome ・ ウォークイン歓迎<br /><span dir="rtl">ترحيب بالزوار بدون حجز</span></span>
      </div>
      <div class="cta">
        <a class="act act-go" href="{{ store.maps_link }}" target="_blank" rel="noopener" data-ga-event="map_click" data-ga-location="hero">
          <span class="act-ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-6.5-6.2-6.5-11.2A6.5 6.5 0 0 1 12 3.3a6.5 6.5 0 0 1 6.5 6.5C18.5 14.8 12 21 12 21z" fill="none" stroke="currentColor" stroke-width="1.4"/><circle cx="12" cy="9.8" r="2.3" fill="none" stroke="currentColor" stroke-width="1.4"/></svg></span>
          <span class="act-tx"><b>Get Directions</b><small>Near {{ store.station_en }}</small></span>
        </a>
        {% if store.tablecheck_url %}
        <a class="act act-rsv" href="{{ store.tablecheck_url }}" target="_blank" rel="noopener" data-ga-event="reserve_click" data-ga-location="hero">
          <span class="act-ic"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.8" y="5.5" width="16.4" height="14.7" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M3.8 10h16.4M8.3 3.5v4M15.7 3.5v4" stroke="currentColor" stroke-width="1.4"/></svg></span>
          <span class="act-tx"><b>Reserve a Table</b><small>{{ store.hours_note }} ・ {{ store.hours }}</small></span>
        </a>
        {% elif store.tel_raw %}
        <a class="act act-rsv" href="tel:{{ store.tel_raw }}" data-ga-event="tel_click" data-ga-location="hero">
          <span class="act-ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 3.8h3l1.5 4-2 1.3a11 11 0 0 0 5.8 5.8l1.3-2 4 1.5v3a1.8 1.8 0 0 1-1.9 1.8A16.4 16.4 0 0 1 4.8 5.7a1.8 1.8 0 0 1 1.8-1.9z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg></span>
          <span class="act-tx"><b>Call to Reserve</b><small>{{ store.tel_display }}</small></span>
        </a>
        {% endif %}
      </div>
    </div>
  </section>

  <section class="about">
    <div class="wrap">
      <div class="niche">
        <img src="/assets/brand/logo-wagyu-black.png" alt="和牛" />
        <h2>Authentic Japanese Wagyu</h2>
        <p>Ḥalāl beef</p>
      </div>
